# ============================================
# CampusGig Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=campusgig

# Connection string used by all backend services
# Format: postgresql://user:password@host:5432/dbname
# In Docker, 'host' is the service name (e.g., 'postgres')
DATABASE_URL=postgresql://postgres:your_password_here@postgres:5432/campusgig

# --- Authentication ---
JWT_SECRET=your_jwt_secret_here

# --- Razorpay (Payment Gateway) ---
# Get test keys from https://dashboard.razorpay.com/app/keys (use test mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
